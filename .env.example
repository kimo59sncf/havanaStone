# Stripe secret key (test or live)
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: Stripe webhook signing secret (whsec_...) for production
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL of the site (used for success/cancel redirects)
BASE_URL=http://localhost:3000

# Server port
PORT=3000

# SMTP (email sending)
SMTP_HOST=smtp.amen.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@havana-stone.com
SMTP_PASS=your_password
SMTP_FROM=info@havana-stone.com
SMTP_TO=info@havana-stone.com

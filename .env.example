# Stripe secret key (test or live)
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: Stripe webhook signing secret (whsec_...) for production
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL of the site (used for success/cancel redirects)
BASE_URL=http://localhost:3000

# Server port
PORT=3000

# Web3Forms (email forwarding) — https://web3forms.com
WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
